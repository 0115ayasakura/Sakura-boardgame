  "story": {
    "cat": "在防波堤上蹲下来，花 ¥{cost} 买了猫粮——这次它没有躲开（+¥{gain}）。",
    "cat_broke": "路过那只野猫，想喂它却连猫粮钱都掏不出来……只能远远看一眼。",
    "monster": "「{name}」从海雾里钻出来！{opponent}抢先一步挡在前面——但挨的那一发修理费跑不掉（-¥{toll}）。",
    "train": "「{name}」在水下亮起灯，生锈的缆绳自己松开了——这是过路费（-¥{toll}）。",
    "tax": "踩到{name}，缴税 ¥{paid}。",
    "bonus": "领到{name}，+¥{amount}。",
    "rent_free": "踩到 {owner}的「{cell}」，租金 ¥{rent}——但{payer}发动『{free_card}』把账单停住了，免租！",
    "salary_double": "经过起点，领工资 +¥{salary}（打捞到的心智魔方让工资翻了倍）。",
    "mortgage_bank": "把「{cell}」抵押给了{bank}，回收 ¥{gain}（抵押期间不收租）。",
    "mortgage_forced": "抵押「{cell}」，回收 ¥{gain}。"
  },
  "event_cards": [
    {
      "title": "三菜军舰便当",
      "flavor": "重樱食堂的招牌，一个驱逐舰装得下三份配菜，也装得下给你留的那一份。",
      "effect": {
        "type": "cash",
        "amount": 150
      }
    },
    {
      "title": "芝士焗薯条",
      "flavor": "被塞了一整盘。吃完才承认，自己是喜欢芝士的。",
      "effect": {
        "type": "cash",
        "amount": 120
      }
    },
    {
      "title": "才艺表演：膝枕体验券",
      "flavor": "被起哄着表演才艺，索性把膝盖借出去一小时，居然还收了钱。",
      "effect": {
        "type": "cash",
        "amount": 100
      }
    },
    {
      "title": "好感度排行榜第二",
      "flavor": "又是第二。回家路上买了一罐宣言可乐冷静了一下。",
      "effect": {
        "type": "cash",
        "amount": -140
      }
    },
    {
      "title": "初月藏的私房钱",
      "flavor": "从抽屉最深处翻出一叠零钱，还有一张字条：「随便拿去用啦♪」",
      "effect": {
        "type": "cash",
        "amount": 150
      }
    },
    {
      "title": "港区的怪谈之夜",
      "flavor": "值夜时听见船坞那边有声音——第二天顶着黑眼圈去买护身符。",
      "effect": {
        "type": "cash",
        "amount": -160
      }
    },
    {
      "title": "旧船坞的遗物",
      "flavor": "锈蚀的舱门后面供着什么，谁也不敢细看。投一枚硬币当香火钱。",
      "effect": {
        "type": "cash",
        "amount": -130
      }
    },
    {
      "title": "排水口探险",
      "flavor": "排水口编号 C-1426。沿着管道走到底，捞上来一件还能用的零件。",
      "effect": {
        "type": "cash",
        "amount": 200
      }
    },
    {
      "title": "演习场的机动奖励",
      "flavor": "贴着弹幕走完了一整轮演习，领到一笔没人争的机动奖金。",
      "effect": {
        "type": "cash",
        "amount": 100
      }
    },
    {
      "title": "指挥部的体检提醒",
      "flavor": "秘书舰在终端上弹出提醒：体检套餐的截止日就是今天。",
      "effect": {
        "type": "cash",
        "amount": -130
      }
    },
    {
      "title": "港区包场KTV",
      "flavor": "把整间包厢包了下来，唱到嗓子哑。最后所有人合唱了那首军歌。",
      "effect": {
        "type": "cash",
        "amount": 180
      }
    },
    {
      "title": "塞壬警报",
      "flavor": "海面下的反应突然上升，全港区进掩体。应急采购花掉不少。",
      "effect": {
        "type": "cash",
        "amount": -150
      }
    },
    {
      "title": "重樱补给配额",
      "flavor": "本季配额批下来了，附言只有四个字：「好好休整」。",
      "effect": {
        "type": "cash",
        "amount": 250
      }
    },
    {
      "title": "秘书舰加班费",
      "flavor": "替指挥官把一整个星期的文件整理完，账面上多出一笔加班费。",
      "effect": {
        "type": "cash",
        "amount": 130
      }
    },
    {
      "title": "港区野猫的祝福",
      "flavor": "第 215 次尝试之后，防波堤上那只灰猫终于让人摸了头。下次掷骰 +1。",
      "effect": {
        "type": "dice_bonus",
        "bonus": 1
      }
    },
    {
      "title": "演习暂停",
      "flavor": "「这段时间先停一停吧，账单的事我记下了」——海面安静下来，一笔租金免了。",
      "effect": {
        "type": "rent_free"
      }
    },
    {
      "title": "沉眠的运输舰",
      "flavor": "在旧泊位边捞到一枚还亮着的心智魔方。下次经过起点，工资翻倍。",
      "effect": {
        "type": "salary_next"
      }
    },
    {
      "title": "沉没的泊位",
      "flavor": "梦见水漫过脚踝，锈蚀的船骸在雾里靠岸。醒来时已经站在起点。",
      "effect": {
        "type": "goto_start"
      }
    },
    {
      "title": "舰队募捐",
      "flavor": "以重樱的名义向在场所有人收了一次募捐。",
      "effect": {
        "type": "collect_each",
        "amount": 100
      }
    },
    {
      "title": "泊地修缮费",
      "flavor": "防波堤要修，钱得大家摊。",
      "effect": {
        "type": "pay_each",
        "amount": 100
      }
    },
    {
      "title": "幸运舰的余裕",
      "flavor": "被卷进塞壬的接触战却毫发无伤，事后领到一笔观测协作津贴。",
      "effect": {
        "type": "cash",
        "amount": 160
      }
    },
    {
      "title": "打捞上来的数据核心",
      "flavor": "从报废的观测机里拆出一块还能读的核心，顺手卖了。",
      "effect": {
        "type": "cash",
        "amount": 110
      }
    },
    {
      "title": "宵禁六点",
      "flavor": "「玩到几点了。」——迟到罚站，零花钱被扣。",
      "effect": {
        "type": "cash",
        "amount": -120
      }
    },
    {
      "title": "周末的约会",
      "flavor": "「太疯跑的话，回来的路会很长哦」——但花掉的每一分都值得。",
      "effect": {
        "type": "cash",
        "amount": -80
      }
    },
    {
      "title": "食堂阿姨的偏爱",
      "flavor": "「今天给你多盛一勺。」——多了这一勺，一整天都是满的。",
      "effect": {
        "type": "cash",
        "amount": 90
      }
    },
    {
      "title": "心智魔方的共鸣",
      "flavor": "魔方与海面下的什么同频了一瞬。回过神来，账上多了一笔谁也说不清来源的钱。",
      "effect": {
        "type": "cash",
        "amount": 800
      },
      "weight": 2,
      "rare": true
    },
    {
      "title": "塞壬的警笛",
      "flavor": "警报毫无预兆地拉响，整片海面都在震。回过神来，钱包和理智都空了一半。",
      "effect": {
        "type": "cash",
        "amount": -620
      },
      "weight": 2,
      "rare": true
    }
  ],
